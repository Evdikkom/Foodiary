<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="0dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_daily_header"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Профиль и настройки"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/buttonClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_back_button"
                    android:clickable="true"
                    android:contentDescription="Закрыть экран настроек"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#7D63BF" />
            </LinearLayout>

            <TextView
                android:id="@+id/textScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Управляйте целью, параметрами тела, активностью и ограничениями. После сохранения дневные нормы будут пересчитаны."
                android:textColor="#F6EEFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_premium_surface_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Основные данные"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupSex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Женщина" />

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Мужчина" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Возраст"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_input"
                        android:hint="25"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Рост, см"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_input"
                        android:hint="175"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Масса тела, кг"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_input"
                        android:hint="70"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Процент жира, %"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editBodyFat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_input"
                        android:hint="необязательно"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Если процент жира известен, приложение сможет точнее считать белок по безжировой массе тела."
                android:textColor="#6B5B73"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardGoalSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_premium_surface_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Физическая активность"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioInactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Неактивный: в основном бытовая активность без регулярных тренировок" />

                <RadioButton
                    android:id="@+id/radioLowActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Низко активный: дополнительно примерно 60–80 минут ходьбы в день" />

                <RadioButton
                    android:id="@+id/radioActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Активный: заметный объём повседневной и тренировочной активности" />

                <RadioButton
                    android:id="@+id/radioVeryActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Очень активный: высокая ежедневная нагрузка или физически тяжёлая работа" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNutritionGoalSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_premium_surface_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цель питания"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioWeightLoss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Снижение массы тела" />

                <RadioButton
                    android:id="@+id/radioMaintainWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Поддержание текущей массы тела" />

                <RadioButton
                    android:id="@+id/radioWeightGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Набор массы тела" />

                <RadioButton
                    android:id="@+id/radioMuscleGainTraining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Набор мышечной массы при силовых тренировках" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Режим набора мышц использует более осторожный профицит калорий и повышенный белок по сравнению с обычным набором массы."
                android:textColor="#6B5B73"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_premium_surface_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/layoutRestrictionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Аллергии и ограничения"
                        android:textColor="#111111"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textRestrictionSummaryCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Можно пропустить, если ограничений нет"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRestrictionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Развернуть"
                    android:textColor="#7B56D8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRestrictionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textRestrictionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Аллергии будут давать строгие предупреждения, непереносимости — более мягкие."
                    android:textColor="#6B5B73"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutRestrictionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textCalculationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Заполните основные параметры, и приложение покажет пересчитанные калории и макронутриенты."
            android:textColor="#6B5B73"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/cardTargetsPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_premium_surface_card_soft"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Предварительный результат"
                android:textColor="#2F2433"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_yellow"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Поддержание"
                        android:textColor="#7A5A00"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textMaintenanceCaloriesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 ккал"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_green"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Цель на день"
                        android:textColor="#51631F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textTargetCaloriesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 ккал"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_premium_surface_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Белки"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textProteinValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_premium_surface_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Жиры"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textFatValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_premium_surface_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Углеводы"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textCarbsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textEnergyExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textProteinExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textGoalExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_premium_primary_button"
            android:minHeight="56dp"
            android:text="Сохранить изменения"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/progressSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
