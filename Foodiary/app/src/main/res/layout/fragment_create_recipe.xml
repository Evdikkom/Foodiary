<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Создать рецепт блюда"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/buttonClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#7B7389" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMealCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#6B5B73"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/cardRecipeImagePicker"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_addmeal_soft_card">

            <ImageView
                android:id="@+id/imageRecipeCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_addmeal_image_rounded"
                android:padding="26dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_custom_dish_placeholder"
                app:tint="#D6BDF8" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_recipe_image_text_badge"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Добавить обложку"
                    android:textColor="#3F2368"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Фото поможет быстрее находить блюдо в списке"
                    android:textColor="#5F4D76"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Название блюда"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_addmeal_input"
            android:hint="Например: Боул с курицей и рисом"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ингредиенты блюда"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

            <TextView
                android:id="@+id/textHelpIngredients"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_help_badge"
                android:gravity="center"
                android:text="?"
                android:textColor="#6F3BB7"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/textIngredientsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Соберите состав блюда и настройте веса ингредиентов"
            android:textColor="#6B5B73"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/cardEmptyIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_addmeal_soft_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Пока ингредиентов нет. Начните с основного продукта, а затем добавьте всё остальное."
                android:textColor="#6B5B73"
                android:textSize="15sp" />

            <Button
                android:id="@+id/buttonAddIngredient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_addmeal_secondary_button"
                android:text="+ Добавить"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutIngredientsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonAddIngredientInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_addmeal_secondary_button"
            android:text="Добавить ещё ингредиент"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вес ингредиентов"
                    android:textColor="#6B5B73"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textIngredientWeightValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_addmeal_input"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="0 г"
                    android:textColor="#2F2433"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вес готового блюда"
                    android:textColor="#6B5B73"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editCookedWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_addmeal_input"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вес одной порции"
                android:textColor="#6B5B73"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editServingWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_addmeal_input"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipServing100"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_product_config_portion_chip_selected"
                    android:gravity="center"
                    android:text="100 г"
                    android:textColor="#5F4D76"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipServing150"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_product_config_portion_chip"
                    android:gravity="center"
                    android:text="150 г"
                    android:textColor="#5F4D76"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipServing250"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_product_config_portion_chip"
                    android:gravity="center"
                    android:text="250 г"
                    android:textColor="#5F4D76"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="КБЖУ"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTotal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_product_config_portion_chip_selected"
                android:gravity="center"
                android:text="Всего"
                android:textColor="#5F4D76"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipPer100"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_product_config_portion_chip"
                android:gravity="center"
                android:text="100 г"
                android:textColor="#5F4D76"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipPortion"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_product_config_portion_chip"
                android:gravity="center"
                android:text="Порция"
                android:textColor="#5F4D76"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_addmeal_soft_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textHeaderLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Всего"
                android:textColor="#6B5B73"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSummaryCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 ккал"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_pink"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Белки"
                        android:textColor="#C03A92"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSummaryProtein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_yellow"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Жиры"
                        android:textColor="#D18600"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSummaryFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_green"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Углеводы"
                        android:textColor="#2A8E50"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSummaryCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardRecipeAllergenSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_addmeal_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Аллергены блюда"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRecipeAllergenSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#6B5B73"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Описание рецепта"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_addmeal_input"
            android:gravity="top|start"
            android:hint="Описание приготовления или заметка"
            android:maxLength="1000"
            android:padding="14dp" />

        <TextView
            android:id="@+id/textDescriptionCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="0/1000"
            android:textColor="#8A8294"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B23A3A"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressSaveRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_addmeal_secondary_button"
            android:text="Сохранить блюдо"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
