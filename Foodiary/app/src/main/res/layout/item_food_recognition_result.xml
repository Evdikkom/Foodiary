<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_addmeal_soft_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textDishName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#2F2433"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkIncludeItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#5F4D76"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Учитывать"
            android:textColor="#5F4D76"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textDishMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#6B5B73"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textDishMacros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#2F2433"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textDishWeightHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Вес этой позиции, г"
        android:textColor="#6B5B73"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editDishWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_addmeal_input"
        android:inputType="numberDecimal"
        android:minHeight="46dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#2F2433"
        android:textColorHint="#988AA0" />

    <TextView
        android:id="@+id/textDishIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#6B5B73"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
