<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollAddMeal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_addmeal_screen_top"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/buttonBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_back_button"
                    android:contentDescription="Назад"
                    android:padding="8dp"
                    android:src="@drawable/ic_foodiary_back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Добавить еду"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="40dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSelectedMealType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_addmeal_soft_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Приём пищи"
                    android:textColor="#6B5B73"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textMealTypeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Завтрак"
                    android:textColor="#2F2433"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textMealDateValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Сегодня, 24 апреля"
                    android:textColor="#6B5B73"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:id="@+id/cardLocalSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_addmeal_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Поиск продуктов"
                    android:textColor="#2F2433"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editSearchFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_addmeal_input"
                    android:hint="Например: рис, банан, сыр"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:minHeight="50dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonCreateFood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_addmeal_secondary_button"
                        android:text="Создать"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/buttonQuickBarcode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_addmeal_secondary_button"
                        android:text="Штрихкод"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonPhotoAnalyze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_addmeal_secondary_button"
                    android:text="Фото блюда"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/buttonHistoryTemplates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_addmeal_secondary_button"
                    android:text="Как обычно"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fadingEdgeLength="28dp"
                    android:requiresFadingEdge="horizontal"
                    android:overScrollMode="always"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/chipSectionRecent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_product_config_portion_chip_selected" android:clickable="true" android:focusable="true" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp" android:text="Недавнее" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/chipSectionFavorites" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp" android:text="Избранное" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/chipSectionCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp" android:text="Мои продукты" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/textSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Рекомендации"
                    android:textColor="#2F2433"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLocalResultsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#6B5B73"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutInlineSearchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar android:id="@+id/progressRemoteSearch" android:layout_width="20dp" android:layout_height="20dp" android:indeterminate="true" android:visibility="gone" />
                    <TextView android:id="@+id/textRemoteSearchStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#6B5B73" android:textSize="13sp" android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFoods"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp" />

                <Button
                    android:id="@+id/buttonShowMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_addmeal_secondary_button"
                    android:text="Показать ещё"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar android:id="@+id/progressImport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
            <TextView android:id="@+id/textError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#A33A3A" android:textSize="14sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
