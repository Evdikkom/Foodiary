<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_addmeal_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/imageFood"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_addmeal_image_rounded"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_custom_food_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textFoodTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textColor="#6B5B73"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Куриная грудка"
            android:textColor="#2F2433"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFoodAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="200 г"
            android:textColor="#6B5B73"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textFoodAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_product_config_portion_chip"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:text="Изменить"
        android:textColor="#5F4D76"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
