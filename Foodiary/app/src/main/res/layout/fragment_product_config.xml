<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_product_config_hero" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView
                android:id="@+id/textBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav_back_button"
                android:contentDescription="Назад"
                android:padding="8dp"
                android:src="@drawable/ic_foodiary_back" />
            <TextView android:id="@+id/textScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Добавить в завтрак" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:baselineAligned="false" android:gravity="top" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/textFoodName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Продукт" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/textProductOriginBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_custom_food_badge" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="Мой продукт" android:textColor="#6F3BB7" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutCustomActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><TextView android:id="@+id/buttonEditCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_product_config_portion_chip" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="Редактировать" android:textColor="#5F4D76" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/><TextView android:id="@+id/buttonRecipeDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_product_config_portion_chip" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="Рецепт" android:textColor="#5F4D76" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/></LinearLayout>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Калорийность" android:textColor="#ECDDFF" android:textSize="14sp"/>
                <TextView android:id="@+id/textHeaderCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 ккал" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/layoutMacros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Белки"
                            android:textColor="#ECDDFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textProtein"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 г"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Жиры"
                            android:textColor="#ECDDFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textFat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 г"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Углеводы"
                            android:textColor="#ECDDFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textCarbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 г"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="104dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="top|center_horizontal" android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageFood"
                    android:layout_width="100dp"
                    android:layout_height="97dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/FoodiaryProductImageShape"
                    app:srcCompat="@android:color/transparent" />

                <ImageView
                    android:id="@+id/buttonFavorite"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="34dp"
                    android:background="@drawable/bg_product_config_favorite_button"
                    android:clickable="true"
                    android:contentDescription="Избранное"
                    android:focusable="true"
                    android:padding="11dp"
                    app:srcCompat="@drawable/ic_favorite_outline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_addmeal_card" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Размер порции" android:textColor="#2F2433" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/chipMeasureGram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_product_config_portion_chip_selected" android:clickable="true" android:focusable="true" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="г" android:textColor="#5F4D76" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/chipMeasureMl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="мл" android:textColor="#5F4D76" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/chipPortion50" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp" android:text="50" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/chipPortion100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_product_config_portion_chip_selected" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp" android:text="100" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/chipPortion150" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp" android:text="150" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/chipPortion200" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_product_config_portion_chip" android:clickable="true" android:focusable="true" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp" android:text="200" android:textColor="#5F4D76" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/buttonMinus" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_product_config_step_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="−" android:textColor="#5F4D76" android:textSize="24sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/editQuantity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_product_config_quantity" android:gravity="center" android:hint="Количество (г)" android:inputType="numberDecimal" android:minHeight="56dp" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="14dp" android:textColor="#2F2433" android:textColorHint="#9F93AE" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/buttonPlus" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:background="@drawable/bg_product_config_step_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="+" android:textColor="#5F4D76" android:textSize="24sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutPortionMemory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_product_config_portion_chip"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textPortionMemoryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipPortionMemoryFavorite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_product_config_portion_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp"
                            android:textColor="#5F4D76"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipPortionMemoryLast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_product_config_portion_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp"
                            android:textColor="#5F4D76"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/textSourcePortionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#6B5B73"
                    android:textSize="13sp"
                    android:visibility="gone"/>
                <LinearLayout
                    android:id="@+id/cardImpactPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_addmeal_soft_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textImpactScore"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_daily_chip"
                            android:gravity="center"
                            android:text="0/10"
                            android:textColor="#2F2433"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Что будет, если съесть?"
                                android:textColor="#6F3BB7"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textImpactTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Прогноз влияния"
                                android:textColor="#2F2433"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textImpactSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#5F4D76"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/layoutImpactMacros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textImpactPortionAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_product_config_portion_chip"
                        android:padding="12dp"
                        android:textColor="#5F4D76"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutImpactDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardAllergenSafety"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textAllergenSafetyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#2F2433"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textAllergenSafetySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#5F4D76"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textAllergenSafetyDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />
                </LinearLayout>
                <EditText android:id="@+id/editNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_addmeal_input" android:hint="Заметка (необязательно)" android:minHeight="52dp" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp"/>
                <TextView android:id="@+id/textError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#A33A3A" android:textSize="14sp" android:visibility="gone"/>
                <Button android:id="@+id/buttonSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_addmeal_primary_button" android:text="Сохранить" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
                <ProgressBar android:id="@+id/progressSaving" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_addmeal_card" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Детально" android:textColor="#2F2433" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/textFoodBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_daily_chip" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="На 100 г" android:textColor="#2F2433" android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Калории" android:textColor="#2F2433" android:textSize="17sp"/>
                        <TextView android:id="@+id/textDetailCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ккал" android:textColor="#2F2433" android:textSize="17sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8E1F1"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Белки" android:textColor="#2F2433" android:textSize="17sp"/>
                        <TextView android:id="@+id/textDetailProtein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 г" android:textColor="#2F2433" android:textSize="17sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8E1F1"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Жиры" android:textColor="#2F2433" android:textSize="17sp"/>
                        <TextView android:id="@+id/textDetailFat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 г" android:textColor="#2F2433" android:textSize="17sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8E1F1"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Углеводы" android:textColor="#2F2433" android:textSize="17sp"/>
                        <TextView android:id="@+id/textDetailCarbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 г" android:textColor="#2F2433" android:textSize="17sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
