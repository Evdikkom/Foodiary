<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="0dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_daily_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Профиль и персональные нормы"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Сначала приложение сохраняет твои исходные данные, затем рассчитывает калории и макронутриенты по научной модели."
                android:textColor="#F6EEFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_addmeal_soft_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Как работает расчёт"
                android:textColor="#2F2433"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="1. Сначала приложение рассчитывает калории поддержания по официальным формулам Dietary Reference Intakes for Energy 2023."
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. Затем цель пользователя переводит поддержание в режим снижения, поддержания, набора массы или набора мышечной массы."
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="3. Если известен процент жира, белок считается по безжировой массе тела. Если процент жира не указан, приложение использует более осторожную расчётную базу."
                android:textColor="#4A3E55"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_addmeal_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Биологический пол"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupSex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Женщина" />

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Мужчина" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Возраст"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_addmeal_input"
                        android:hint="25"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Рост, см"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_addmeal_input"
                        android:hint="175"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Масса тела, кг"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_addmeal_input"
                        android:hint="70"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Процент жира, %"
                        android:textColor="#111111"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editBodyFat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_addmeal_input"
                        android:hint="необязательно"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Если процент жира известен, приложение сможет считать белок по безжировой массе тела, а не только по общей массе."
                android:textColor="#6B5B73"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_addmeal_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Уровень физической активности"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioInactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Неактивный: в основном бытовая активность без регулярной нагрузки" />

                <RadioButton
                    android:id="@+id/radioLowActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Низко активный: дополнительно примерно 60–80 минут ходьбы в день" />

                <RadioButton
                    android:id="@+id/radioActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Активный: заметный объём повседневной и тренировочной активности" />

                <RadioButton
                    android:id="@+id/radioVeryActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Очень активный: высокая ежедневная нагрузка или физически тяжёлая работа" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_addmeal_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цель"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioWeightLoss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Снижение массы тела" />

                <RadioButton
                    android:id="@+id/radioMaintainWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Поддержание текущей массы тела" />

                <RadioButton
                    android:id="@+id/radioWeightGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Набор массы тела" />

                <RadioButton
                    android:id="@+id/radioMuscleGainTraining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Набор мышечной массы при силовых тренировках" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Обычный набор массы использует стартовый профицит калорий. Режим набора мышечной массы при силовых тренировках задаёт более осторожный динамический профицит и повышенный белок."
            android:textColor="#6B5B73"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_addmeal_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/layoutRestrictionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Аллергии и ограничения"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textRestrictionSummaryCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Не выбрано"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRestrictionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Развернуть"
                    android:textColor="#7B56D8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRestrictionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Отмеченные здесь аллергены будут учитываться в предупреждениях и дальнейших рекомендациях. Повторное нажатие снимает выбор."
                    android:textColor="#6B5B73"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutRestrictionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textRestrictionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Если ничего не отмечено, приложение не будет фильтровать продукты по аллергенам."
                    android:textColor="#6B5B73"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textCalculationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#6B5B73"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/cardTargetsPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_addmeal_soft_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Предварительный результат"
                android:textColor="#2F2433"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_yellow"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Поддержание"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textMaintenanceCaloriesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 ккал"
                        android:textColor="#2F2433"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_macro_card_green"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Цель на день"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textTargetCaloriesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 ккал"
                        android:textColor="#2F2433"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_addmeal_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Белки"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textProteinValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_addmeal_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Жиры"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textFatValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_addmeal_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Углеводы"
                        android:textColor="#6B5B73"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textCarbsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 г"
                        android:textColor="#2F2433"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textEnergyExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textProteinExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textGoalExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#4A3E55"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_addmeal_primary_button"
            android:text="Сохранить профиль и применить нормы"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/progressSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
