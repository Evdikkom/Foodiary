<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_addmeal_soft_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imageIngredient"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_addmeal_image_rounded"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_custom_food_placeholder"
        app:tint="#8B63D5" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textIngredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textIngredientMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:textColor="#6B5B73"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editIngredientWeight"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_addmeal_input"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:minHeight="44dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="г"
        android:textColor="#6B5B73"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/buttonRemoveIngredient"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#7B7389" />

</LinearLayout>
